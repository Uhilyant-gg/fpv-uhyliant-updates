 function val(v,suffix,digits){return v===undefined||v===null?"--":Number(v).toFixed(digits===undefined?0:digits)+(suffix||"")}
 function stopPrimary(){videoRecovery.stop();player.stop();videoRuntime.stop();videoRecoveryCount=0}
 function stopSecondary(){secondaryRecovery.stop();secondaryPlayer.stop();secondaryVideoRuntime.stop();secondaryRecoveryCount=0}
 function setPip(enabled){pipEnabled=enabled&&streamWorkspace.state.pipAvailable;videoWorkspaceRuntime.setPipEnabled(pipEnabled);if(!pipEnabled)stopSecondary();else startSecondary()}
 function connectDevice(id){stopPrimary();setPip(false);devicesModel.setActive(id);streamWorkspace.autoSelect()}
 function disconnectDevice(){stopPrimary();setPip(false);videoWorkspaceRuntime.stopAll();devicesModel.clearActive();streamWorkspace.autoSelect()}
 function startSelected(){stopPrimary();if(connected&&selectedStreamId!==""&&videoWorkspaceRuntime.preparePrimary(selectedStreamId)){player.source=videoRuntime.url;player.play()}if(pipEnabled)startSecondary()}
 function startSecondary(){stopSecondary();if(pipEnabled&&connected&&secondaryStreamId!==""&&videoWorkspaceRuntime.prepareSecondary(secondaryStreamId)){secondaryPlayer.source=secondaryVideoRuntime.url;secondaryPlayer.play()}}
 function rebuildPlayback(){var wasPlaying=player.playbackState===MediaPlayer.PlayingState||videoRuntime.streamId!=="";stopPrimary();stopSecondary();if(wasPlaying)startSelected()}
 function recoverPrimary(){if(!connected||videoRuntime.url==="")return;if(videoRecoveryCount>=5){videoRuntime.markStalled("Автоматичне відновлення primary RTSP не вдалося після 5 спроб");return}videoRecoveryCount++;player.stop();if(videoRuntime.reconnect()){player.source="";player.source=videoRuntime.url;player.play()}else videoRecovery.start()}
 function recoverSecondary(){if(!pipEnabled||secondaryVideoRuntime.url==="")return;if(secondaryRecoveryCount>=5){secondaryVideoRuntime.markStalled("Автоматичне відновлення secondary RTSP не вдалося після 5 спроб");return}secondaryRecoveryCount++;secondaryPlayer.stop();if(secondaryVideoRuntime.reconnect()){secondaryPlayer.source="";secondaryPlayer.source=secondaryVideoRuntime.url;secondaryPlayer.play()}else secondaryRecovery.start()}
