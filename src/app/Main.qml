import QtQuick.Window
import QtMultimedia
ApplicationWindow {
 id:w;visible:true;visibility:Window.Maximized;minimumWidth:1024;minimumHeight:640;color:"#050a12";title:appWindowTitle
 property color fg:"#f4f7fb";property color sub:"#8fa1b7";property color panel:"#e6101927";property color line:"#273d55";property color green:"#27d59a";property color blue:"#2387ff";property color amber:"#ffb84d";property color red:"#ff6678"
 property bool connected:devicesModel.activeName!=="";property string selectedStreamId:streamWorkspace.state.primaryId||"";property var t:telemetryRuntime.telemetry;property var vd:videoRuntime.diagnostics;property int videoRecoveryCount:0
 function val(v,suffix,digits){return v===undefined||v===null?"--":Number(v).toFixed(digits===undefined?0:digits)+(suffix||"")}
 function connectDevice(id){videoRecovery.stop();player.stop();videoRuntime.stop();devicesModel.setActive(id);streamWorkspace.autoSelect()}
 function disconnectDevice(){videoRecovery.stop();player.stop();videoRuntime.stop();devicesModel.clearActive();streamWorkspace.autoSelect()}
 function startSelected(){videoRecovery.stop();videoRecoveryCount=0;if(connected&&selectedStreamId!==""&&videoRuntime.prepare(selectedStreamId)){player.source=videoRuntime.url;player.play()}}
 function recoverVideo(){if(!connected||videoRuntime.url==="")return;if(videoRecoveryCount>=5){videoRecovery.stop();videoRuntime.markStalled("Автоматичне відновлення RTSP не вдалося після 5 спроб");return}videoRecoveryCount++;player.stop();if(videoRuntime.reconnect()){player.source="";player.source=videoRuntime.url;player.play()}else videoRecovery.start()}
 AudioOutput{id:audioOut;muted:true}
 MediaPlayer{id:player;videoOutput:videoOut;audioOutput:audioOut;onPlayingChanged:{if(playing){videoRecovery.stop();videoRecoveryCount=0;videoRuntime.markPlaying()}else if(videoRuntime.streamId!==""&&videoRuntime.state==="playing"){videoRuntime.markStalled("Відтворення RTSP несподівано зупинилося");videoRecovery.restart()}} onErrorOccurred:function(error,errorString){videoRuntime.playbackError(errorString);if(videoRuntime.streamId!=="")videoRecovery.restart()}}
 Timer{id:videoRecovery;interval:2000;repeat:false;onTriggered:recoverVideo()}
 component OsdText:Text{color:"white";font.family:"Consolas";font.pixelSize:17;font.bold:true;style:Text.Outline;styleColor:"#c0000000"}
 Shortcut{sequence:"F2";enabled:connected;onActivated:startSelected()} Shortcut{sequence:"F11";onActivated:w.visibility=w.visibility===Window.FullScreen?Window.Maximized:Window.FullScreen}
 StackLayout{id:pages;currentIndex:connected?1:0;anchors.fill:parent
  Item{ColumnLayout{anchors.fill:parent;anchors.margins:24;RowLayout{Layout.fillWidth:true;Text{text:"ФПВ УХИЛЯНТ";color:fg;font.pixelSize:28;font.bold:true}Item{Layout.fillWidth:true}Button{text:"Firmware";onClicked:firmwarePopup.open()}Button{text:"Пристрої";onClicked:devices.open()}}ListView{id:deviceList;Layout.fillWidth:true;Layout.fillHeight:true;model:devicesModel.items;delegate:Button{required property var modelData;width:deviceList.width;text:modelData.name+" · "+modelData.host;onClicked:connectDevice(modelData.id)}}}
  Item{Rectangle{anchors.fill:parent;color:"black"}VideoOutput{id:videoOut;anchors.fill:parent;fillMode:VideoOutput.PreserveAspectFit}Column{visible:player.playbackState!==MediaPlayer.PlayingState;anchors.centerIn:parent;spacing:10;Text{text:videoRuntime.state.toUpperCase();color:fg;font.pixelSize:22;font.bold:true}Text{text:videoRuntime.error;color:red;visible:text!==""}Button{text:"Запустити відео";enabled:selectedStreamId!=="";onClicked:startSelected()}}
   Row{anchors.left:parent.left;anchors.top:parent.top;anchors.margins:18;spacing:22;visible:t.connected===true;OsdText{text:t.armed===null||t.armed===undefined?"ARM --":(t.armed?"ARMED":"DISARMED")}OsdText{text:t.flightMode||"MODE --"}OsdText{text:"BAT "+val(t.batteryVoltage,"V",1)}}
   Row{anchors.left:parent.left;anchors.bottom:parent.bottom;anchors.margins:18;spacing:18;OsdText{text:(t.connected?"● ":"○ ")+telemetryRuntime.name;color:t.connected?green:red}OsdText{visible:vd.streamId!==null;text:"VIDEO "+(vd.kind||"--").toUpperCase()+" · "+(vd.codec||"--").toUpperCase()+" · "+(vd.width&&vd.height?vd.width+"×"+vd.height:"--")+" · "+(vd.fps||"--")+" FPS";color:videoRuntime.running?green:sub}}
   Button{anchors.right:parent.right;anchors.bottom:parent.bottom;anchors.margins:14;text:"☰";onClicked:flightMenu.open()}
  }
 }
 }
 Popup{id:flightMenu;x:w.width-width-18;y:18;width:340;height:Math.min(560,w.height-36);background:Rectangle{color:"#f70b1522";border.color:line;radius:12}contentItem:ColumnLayout{anchors.fill:parent;anchors.margins:16;Text{text:devicesModel.activeName;color:fg;font.pixelSize:20;font.bold:true}Button{text:"Потоки / PiP";onClicked:{flightMenu.close();streamsPopup.open()}}Button{text:"Firmware";onClicked:{flightMenu.close();firmwarePopup.open()}}Button{text:"Діагностика";onClicked:{flightMenu.close();diagnostics.open()}}Button{text:"Пристрої";onClicked:{flightMenu.close();devices.open()}}Item{Layout.fillHeight:true}Button{text:"Відключитися";onClicked:{flightMenu.close();disconnectDevice()}}}}
 Popup{id:streamsPopup;modal:true;anchors.centerIn:Overlay.overlay;width:Math.min(760,w.width-48);height:Math.min(560,w.height-60);background:Rectangle{color:"#0d1725";border.color:blue;radius:14}contentItem:ColumnLayout{anchors.fill:parent;anchors.margins:20;Text{text:"VIDEO WORKSPACE";color:fg;font.pixelSize:22;font.bold:true}Text{text:"Primary: "+(streamWorkspace.state.primaryKind||"--")+" · Secondary: "+(streamWorkspace.state.secondaryKind||"--")+" · PiP: "+(streamWorkspace.state.pipAvailable?"available":"unavailable");color:sub}ListView{Layout.fillWidth:true;Layout.fillHeight:true;model:devicesModel.activeStreams;delegate:RowLayout{required property var modelData;width:ListView.view.width;Text{text:modelData.name+" · "+modelData.kind;color:fg;Layout.fillWidth:true}Button{text:"Primary";onClicked:streamWorkspace.selectPrimary(modelData.id)}Button{text:"Secondary";enabled:modelData.id!==streamWorkspace.state.primaryId;onClicked:streamWorkspace.selectSecondary(modelData.id)}}}RowLayout{Button{text:"Swap";enabled:streamWorkspace.state.pipAvailable;onClicked:streamWorkspace.swap()}Button{text:"Запустити Primary";enabled:streamWorkspace.state.primaryId!=="";onClicked:{streamsPopup.close();startSelected()}}Item{Layout.fillWidth:true}Button{text:"Закрити";onClicked:streamsPopup.close()}}}}
 Popup{id:diagnostics;modal:true;anchors.centerIn:Overlay.overlay;width:Math.min(820,w.width-48);height:Math.min(580,w.height-60);background:Rectangle{color:"#0d1725";border.color:green;radius:14}contentItem:ColumnLayout{anchors.fill:parent;anchors.margins:20;Text{text:"ДІАГНОСТИКА";color:fg;font.pixelSize:22;font.bold:true}Text{text:"Telemetry: "+telemetryRuntime.name+" · "+(t.health||"unavailable");color:sub}Text{text:"Stream: "+(vd.streamName||"--")+" · "+(vd.kind||"--")+" · "+(vd.codec||"--");color:sub}Text{text:"Format: "+(vd.width&&vd.height?vd.width+"×"+vd.height:"--")+" · "+(vd.fps||"--")+" FPS · "+(vd.latencyMode||"--");color:sub}Text{text:"Endpoint check: "+(vd.endpointCheckMs===null?"--":vd.endpointCheckMs+" ms")+" (reachability, не video latency)";color:sub}Text{text:"Playback: "+videoRuntime.state+" · attempts "+videoRuntime.attempts;color:sub}Text{text:videoRuntime.error;color:red;visible:text!==""}Item{Layout.fillHeight:true}Button{text:"Закрити";onClicked:diagnostics.close()}}}
 Popup{id:firmwarePopup;modal:true;anchors.centerIn:Overlay.overlay;width:Math.min(900,w.width-48);height:Math.min(700,w.height-60);background:Rectangle{color:"#0d1725";border.color:amber;radius:14}contentItem:FirmwareCenter{anchors.fill:parent;anchors.margins:22;onCloseRequested:firmwarePopup.close()}}
 Popup{id:devices;modal:true;anchors.centerIn:Overlay.overlay;width:Math.min(1000,w.width-48);height:Math.min(680,w.height-80);background:Rectangle{color:"#0d1725";border.color:blue;radius:14}contentItem:DevicesPanel{anchors.fill:parent;anchors.margins:22;onCloseRequested:devices.close()}}
}
