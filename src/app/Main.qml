 Rectangle{Layout.fillWidth:true;height:1;color:line}Text{text:"Підключення (read-only)";color:fg;font.bold:true}TextField{id:mavEndpoint;Layout.fillWidth:true;text:mavlinkRuntime.endpoint;placeholderText:"udpin:0.0.0.0:14550 або COM3"}SpinBox{id:mavBaud;from:1200;to:4000000;value:mavlinkRuntime.baud;editable:true}CheckBox{id:mavEnabled;text:"MAVLink увімкнено";checked:mavlinkRuntime.enabled}RowLayout{Layout.fillWidth:true;Button{text:"Зберегти / перепідключити";onClicked:mavlinkRuntime.configure(mavEndpoint.text,mavBaud.value,mavEnabled.checked)}Item{Layout.fillWidth:true}Button{text:"Закрити";onClicked:telemetryPopup.close()}}Item{Layout.fillHeight:true}}}
