  Item{Rectangle{anchors.fill:parent;color:"black"}VideoOutput{id:videoOut;anchors.fill:parent;fillMode:VideoOutput.PreserveAspectFit;visible:player.mediaStatus!==MediaPlayer.NoMedia}Column{visible:player.playbackState!==MediaPlayer.PlayingState;anchors.centerIn:parent;spacing:12;Text{text:videoRuntime.state==="checking"?"ПЕРЕВІРКА RTSP":videoRuntime.state==="reconnecting"?"ВІДНОВЛЕННЯ RTSP":videoRuntime.state==="stalled"?"ВІДЕОПОТІК ЗУПИНЕНО":"ВІДЕОПОТІК ГОТОВИЙ";color:fg;font.pixelSize:22;font.bold:true}Text{text:videoRuntime.error;color:red;visible:text!==""}Text{text:videoRecovery.running?"Автоповтор через 2 с • "+videoRecoveryCount+"/5":"";color:amber;visible:text!==""}Button{text:"Запустити відео";enabled:selectedStreamId!=="";onClicked:startSelected()}}
   Row{anchors.left:parent.left;anchors.top:parent.top;anchors.margins:18;spacing:22;visible:t.connected===true;OsdText{text:t.armed===null||t.armed===undefined?"ARM --":(t.armed?"ARMED":"DISARMED");color:t.armed===true?amber:(t.armed===false?green:sub)}OsdText{text:t.flightMode||"MODE --"}OsdText{text:"BAT "+val(t.batteryVoltage,"V",1)}}
