 function val(v,suffix,digits){return v===undefined||v===null?"--":Number(v).toFixed(digits===undefined?0:digits)+(suffix||"")}
 function connectDevice(id){player.stop();videoRuntime.stop();selectedStreamId="";devicesModel.setActive(id);if(devicesModel.activeStreams.length>0)selectedStreamId=devicesModel.activeStreams[0].id}
 function disconnectDevice(){player.stop();videoRuntime.stop();selectedStreamId="";devicesModel.clearActive()}
 function startSelected(){if(connected&&selectedStreamId!==""&&videoRuntime.prepare(selectedStreamId)){player.source=videoRuntime.url;player.play()}}
