    RowLayout{Layout.fillWidth:true;Button{text:"Зробити активною";Layout.fillWidth:true;enabled:selectedSaved!==null;onClicked:root.activateDevice(selectedSaved.id)}Button{text:"⋯";enabled:selectedSaved!==null;onClicked:savedDetails.open()}}}}
