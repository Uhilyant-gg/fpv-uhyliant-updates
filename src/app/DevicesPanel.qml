   Text{visible:devicesModel.manualError!=="";text:devicesModel.manualError;color:danger;wrapMode:Text.WordWrap;Layout.fillWidth:true}
   Rectangle{visible:devicesModel.manualResult.openipc===true;Layout.fillWidth:true;height:104;radius:12;color:"#15392f";Column{anchors.fill:parent;anchors.margins:10;spacing:4;Text{text:"OpenIPC підтверджено";color:accent;font.bold:true}Text{text:"Platform / SoC: "+value(devicesModel.manualResult.identity.platform)+" / "+value(devicesModel.manualResult.identity.soc);color:fg}Text{text:"Sensor: "+value(devicesModel.manualResult.identity.sensor);color:fg}Text{text:"Firmware: "+value(devicesModel.manualResult.identity.firmware);color:fg}}}
   RowLayout{Layout.fillWidth:true
