 Popup { id: authPopup; anchors.centerIn: parent; width: Math.min(440, root.width - 40); modal: true; padding: UiTokens.space20; background: Rectangle { color: UiTokens.elevated; radius: UiTokens.radiusDialog; border.color: UiTokens.line } contentItem: ColumnLayout { spacing: UiTokens.space12; Text { text: "Доступ до камери"; color: UiTokens.foreground; font.pixelSize: UiTokens.fontSection; font.bold: true } Text { text: root.authHost; color: UiTokens.secondary } TextField { id: authUser; Layout.fillWidth: true; text: "root"; placeholderText: "Логін" } TextField { id: authPassword; Layout.fillWidth: true; placeholderText: "Пароль"; echoMode: TextInput.Password } Text { visible: devicesModel.manualError !== ""; text: devicesModel.manualError; color: UiTokens.problem; wrapMode: Text.WordWrap; Layout.fillWidth: true } RowLayout { Button { text: "Перевірити й додати"; font.bold: true; onClicked: { var added = devicesModel.authenticateAndAdd(root.authHost, root.authName, authUser.text, authPassword.text); authPassword.text = ""; if (added !== "") authPopup.close() } } Item { Layout.fillWidth: true } Button { text: "Скасувати"; flat: true; onClicked: { authPassword.text = ""; authPopup.close() } } } }
