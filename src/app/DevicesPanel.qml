 Popup { id: detailsPopup; anchors.centerIn: parent; width: Math.min(540, root.width - 40); modal: true; padding: UiTokens.space20; background: Rectangle { color: UiTokens.elevated; radius: UiTokens.radiusDialog; border.color: UiTokens.line } contentItem: ColumnLayout { spacing: UiTokens.space8; Text { text: "Відомості про камеру"; color: UiTokens.foreground; font.pixelSize: UiTokens.fontSection; font.bold: true } Text { text: "Адреса  " + (selectedFound ? selectedFound.host : ""); color: UiTokens.foreground } Text { text: "OpenIPC  " + (selectedFound && selectedFound.openipc ? "підтверджено" : "не підтверджено"); color: selectedFound && selectedFound.openipc ? UiTokens.ready : UiTokens.secondary } Text { text: "Платформа / SoC  " + value(selectedFound ? selectedFound.identity.platform : "") + " / " + value(selectedFound ? selectedFound.identity.soc : ""); color: UiTokens.foreground } Text { text: "Сенсор  " + value(selectedFound ? selectedFound.identity.sensor : ""); color: UiTokens.foreground } Text { text: "Прошивка  " + value(selectedFound ? selectedFound.identity.firmware : ""); color: UiTokens.foreground } Button { text: "Закрити"; Layout.alignment: Qt.AlignRight; onClicked: detailsPopup.close() } }
