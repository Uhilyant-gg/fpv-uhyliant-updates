 Popup { id: manualPopup; anchors.centerIn: parent; width: Math.min(500, root.width - 40); modal: true; padding: UiTokens.space20; background: Rectangle { color: UiTokens.elevated; radius: UiTokens.radiusDialog; border.color: UiTokens.line }
  ColumnLayout { width: parent.width; spacing: UiTokens.space12; Text { text: "Вказати IP"; color: UiTokens.foreground; font.family: UiTokens.fontFamily; font.pixelSize: UiTokens.fontSection; font.weight: Font.DemiBold } Text { text: "Введіть адресу камери. Решту програма перевірить автоматично."; color: UiTokens.secondary; wrapMode: Text.WordWrap; Layout.fillWidth: true } TextField { id: manualIp; Layout.fillWidth: true; placeholderText: "192.168.1.50"; inputMethodHints: Qt.ImhFormattedNumbersOnly } Text { visible: devicesModel.manualBusy; text: "Перевіряємо камеру…"; color: UiTokens.primary } Text { visible: !devicesModel.manualBusy && devicesModel.manualMessage !== ""; text: devicesModel.manualMessage; color: devicesModel.manualStatus === "added" || devicesModel.manualStatus === "verified" ? UiTokens.ready : UiTokens.secondary; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.bold: true } Text { visible: devicesModel.manualError !== ""; text: devicesModel.manualError; color: UiTokens.problem; wrapMode: Text.WordWrap; Layout.fillWidth: true } Rectangle { visible: devicesModel.manualResult.openipc === true; Layout.fillWidth: true; height: 104; radius: UiTokens.radiusControl; color: UiTokens.interactive; Column { anchors.fill: parent; anchors.margins: UiTokens.space12; spacing: UiTokens.space4; Text { text: "OpenIPC підтверджено"; color: UiTokens.ready; font.bold: true } Text { text: "Платформа / SoC: " + value(devicesModel.manualResult.identity.platform) + " / " + value(devicesModel.manualResult.identity.soc); color: UiTokens.foreground } Text { text: "Сенсор: " + value(devicesModel.manualResult.identity.sensor); color: UiTokens.foreground } Text { text: "Прошивка: " + value(devicesModel.manualResult.identity.firmware); color: UiTokens.foreground } } } RowLayout { Layout.fillWidth: true; Button { text: devicesModel.manualBusy ? "Перевірка…" : "Перевірити"; enabled: !devicesModel.manualBusy; onClicked: devicesModel.inspectManualIp(manualIp.text) } Button { text: devicesModel.manualStatus === "added" ? "Додано" : "Додати"; enabled: !devicesModel.manualBusy && devicesModel.manualStatus !== "added" && devicesModel.manualResult.camera === true; onClicked: { if (devicesModel.manualResult.openipc && devicesModel.manualResult.identityVerified) { var id = devicesModel.addDiscovered(devicesModel.manualResult.host, "OpenIPC " + devicesModel.manualResult.host, true); if (id !== "") selectedSaved = null } else { root.authHost = devicesModel.manualResult.host; root.authName = "Камера " + devicesModel.manualResult.host; manualPopup.close(); authPopup.open() } } } Item { Layout.fillWidth: true } Button { text: "Закрити"; flat: true; onClicked: manualPopup.close() } }
