 Popup { id: savedDetails; anchors.centerIn: parent; width: Math.min(500, root.width - 40); modal: true; padding: UiTokens.space20; background: Rectangle { color: UiTokens.elevated; radius: UiTokens.radiusDialog; border.color: UiTokens.line } contentItem: ColumnLayout { spacing: UiTokens.space8; Text { text: selectedSaved ? selectedSaved.name : "Камера"; color: UiTokens.foreground; font.pixelSize: UiTokens.fontSection; font.bold: true } Text { text: selectedSaved ? selectedSaved.host : ""; color: UiTokens.secondary } Text { text: selectedSaved && selectedSaved.openipcIdentity.verified ? "OpenIPC підтверджено" : "OpenIPC не підтверджено"; color: selectedSaved && selectedSaved.openipcIdentity.verified ? UiTokens.ready : UiTokens.secondary } Text { visible: selectedSaved && selectedSaved.openipcIdentity.verified; text: "Платформа / SoC  " + value(selectedSaved ? selectedSaved.openipcIdentity.platform : "") + " / " + value(selectedSaved ? selectedSaved.openipcIdentity.soc : ""); color: UiTokens.foreground } Text { visible: selectedSaved && selectedSaved.openipcIdentity.verified; text: "Сенсор  " + value(selectedSaved ? selectedSaved.openipcIdentity.sensor : ""); color: UiTokens.foreground } Button { text: "Закрити"; Layout.alignment: Qt.AlignRight; onClicked: savedDetails.close() } }
